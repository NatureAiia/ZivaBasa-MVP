# Copy to .env and fill in what you have. Neither is required for /predict, /explain,
# /schema, /health, or /predict/batch/{task} — only /chat needs one of these.

# Anthropic Claude API — paid/metered, no standing free tier. Get a key at
# https://console.anthropic.com. Model defaults to claude-sonnet-5; override with
# ANTHROPIC_MODEL if you want a different one (e.g. claude-haiku-4-5-20251001 for lower cost).
ANTHROPIC_API_KEY=

# NVIDIA NIM (build.nvidia.com) — has historically offered free preview API credits with rate
# limits for hosted models including the Nemotron family, but this was NOT verified live
# against NVIDIA's current catalog/pricing while building this integration (that domain isn't
# reachable from the sandbox this was built in) — check https://build.nvidia.com yourself.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Google Gemini — genuine free tier via AI Studio, verify current limits at
# https://ai.google.dev/pricing. Get a key at https://aistudio.google.com/apikey.
# Powers: /chat (Gemini Flash model), organization-chart vision extraction
# (POST /organization/extract), and image generation (POST /images/generate, and the
# generate_image chat tool available from any chat provider).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Azure OpenAI — image generation AND editing (gpt-image-1 or DALL-E 3, whichever model your
# deployment uses). Get AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY from your Azure OpenAI
# resource (Azure Portal -> your resource -> Keys and Endpoint), and
# AZURE_OPENAI_IMAGE_DEPLOYMENT from the deployment name you gave the image model under
# Azure AI Studio -> Deployments (NOT the underlying model name — Azure deployments are
# user-named). Powers: POST /images/edit (the only editing-capable image endpoint here),
# and is picked automatically over Gemini for complex/detailed generation prompts and org-chart
# illustrations (see api/image_router.py's routing heuristic) — nothing in the frontend or chat
# tool-calling needs to pick this explicitly.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: force one provider even if multiple keys are set above.
# CHAT_PROVIDER=anthropic

# --- Self-hosted database (api/db/) — required for /auth/*, and for every per-user CRUD route
# that used to go straight from the frontend to Supabase. asyncpg driver.
# DATABASE_URL=postgresql+asyncpg://zivabasa:password@localhost:5432/zivabasa

# --- Auth (api/auth_service.py, api/auth_routes.py) ---
# Required for POST /auth/* to work at all, and for require_role()'s local-JWT fallback below.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Refresh-token cookie flags (api/auth_routes.py) — defaults are fine for local HTTP dev.
# Set COOKIE_SECURE=false only for local http:// development; leave true in any real deployment.
# COOKIE_SECURE=true
# Set COOKIE_SAMESITE=none (requires COOKIE_SECURE=true) if the frontend is served from a
# different registrable domain than this API; "lax" (the default) is enough for same-site setups.
# COOKIE_SAMESITE=lax

# Comma-separated list of frontend origins allowed to call this API with credentials (cookies).
# Must be explicit origins, not "*" — browsers reject wildcard + credentials together.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Role-based access control (api/auth.py) — optional, off by default; see that file's
# docstring for the full explanation. Two independent schemes, tried in this order:

# 1) Opaque API keys for machine-to-machine callers, format "key1:role1,key2:role2",
#    roles are viewer/admin/superadmin. The frontend does NOT use this scheme (it never sends
#    a matching key) — this is for direct API callers only.
# ZIVABASA_API_KEYS=

# 2) Real per-user auth for the actual frontend — activates automatically once JWT_SECRET above
#    is set and the frontend has a signed-in session (POST /auth/login).

# --- Token-balance gate (api/tokens.py) — optional, off by default; requires JWT_SECRET above.
# ZIVABASA_TOKEN_GATE_ENABLED=1
