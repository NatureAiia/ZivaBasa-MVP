# Copy to .env (repo root) before `docker compose up --build`. Every value below is optional —
# see docker-compose.yml and backend/api/.env.example / frontend/.env.example for what each
# one unlocks.
#
# The commented-out *_MODEL/CHAT_PROVIDER lines matter: leave them commented unless you want to
# override the default, don't uncomment-and-leave-blank. docker-compose.yml passes this file
# straight through as env_file, and chat.py's `os.environ.get("ANTHROPIC_MODEL", "<default>")`
# only falls back to "<default>" when the key is completely absent — an empty value here would
# override it with "", not with chat.py's actual default.

# --- Backend chat/vision/image providers (only /chat, /images/generate, /organization/extract need one) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Azure OpenAI — image generation AND editing (see backend/api/.env.example for full detail).
# Picked automatically over Gemini for complex prompts and is the only provider that can edit
# an existing image (POST /images/edit).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
# AZURE_OPENAI_API_VERSION=2024-10-21
# Force one provider even if multiple keys above are set.
# CHAT_PROVIDER=anthropic

# --- Frontend Supabase (auth) — baked into the build, see frontend/src/lib/supabaseClient.js ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
